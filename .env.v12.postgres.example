# Windows isolated V12 development only. Run from the project root.
# Copy to .env.v12.postgres, enter existing private credentials, then use:
# uv run --env-file .env.v12.postgres --no-sync python -m uvicorn jobmitra.main:app --app-dir src --host 127.0.0.1 --port 8002 --workers 1
# Clear inherited JOBMITRA_/UVICORN_ overrides first; see the Windows runbook.

JOBMITRA_LOCAL_V12=0
JOBMITRA_V12_BACKEND=postgresql
JOBMITRA_V12_POSTGRES_DEVELOPMENT=true
JOBMITRA_V12_POSTGRES_SCHEMA=jobmitra_v12_dev_20261123_integration
JOBMITRA_ATS_V2_ENABLED=true
JOBMITRA_UNIFIED_V12_ENABLED=true
JOBMITRA_UNIFIED_V12_PROPOSALS_ENABLED=true

JOBMITRA_DB_HOST=192.168.1.51
JOBMITRA_DB_PORT=5432
JOBMITRA_DB_NAME=jobmitra_dev
JOBMITRA_DB_USER='REPLACE_WITH_EXISTING_DB_USERNAME'
JOBMITRA_DB_PASSWORD='REPLACE_WITH_EXISTING_DB_PASSWORD'
# This server has no TLS. Allowed only on the confirmed trusted private office LAN.
JOBMITRA_DB_SSLMODE=disable
JOBMITRA_V12_POSTGRES_TRUSTED_LAN=true
JOBMITRA_DB_CONNECT_TIMEOUT=5
JOBMITRA_DB_POOL_SIZE=3
JOBMITRA_DB_MAX_OVERFLOW=0
JOBMITRA_DB_POOL_TIMEOUT=5
JOBMITRA_DB_STATEMENT_TIMEOUT_MS=5000

# Direct editing is development-only; startup/requests reject non-loopback access.
# All three roots must remain inside this checkout's runtime directory.
# These are literal absolute Windows paths; %CD% is not expanded inside this file.
# Adjust all three if your checkout is in a different location.
JOBMITRA_UNIFIED_V12_LOCAL_DIRECT_EDITING=true
# Optional Office LAN mode: explicitly set ENABLED=true and LOCAL_DIRECT_EDITING=false.
# Verify the office subnet on Windows before enabling; no public/proxy access.
JOBMITRA_OFFICE_LAN_ENABLED=false
JOBMITRA_OFFICE_LAN_CIDRS=192.168.1.0/24,127.0.0.1/32,::1/128
JOBMITRA_OFFICE_LAN_HOSTS=
JOBMITRA_ATS_V2_RESUME_STORAGE_ROOT='C:/Users/PC/Documents/jobmitra-saas/jobmitra-sop-saas/runtime/v12-pg-dev/resumes'
# Original, altered and parsed documents share the resume root above:
# original/candidate_<ID>/, altered/candidate_<ID>/, parsed/candidate_<ID>/
JOBMITRA_UNIFIED_V12_PROPOSAL_STORAGE_ROOT='C:/Users/PC/Documents/jobmitra-saas/jobmitra-sop-saas/runtime/v12-pg-dev/proposals'
JOBMITRA_DOCUMENT_STORAGE_ROOT='C:/Users/PC/Documents/jobmitra-saas/jobmitra-sop-saas/runtime/v12-pg-dev/legacy-documents'
JOBMITRA_RESUME_MAX_BYTES=10485760
JOBMITRA_DOCUMENT_MAX_BYTES=12582912

JOBMITRA_RESUME_PROCESSING_ENABLED=false
JOBMITRA_AI_ENABLED=false
JOBMITRA_OFFICE_TIMEZONE=Asia/Kolkata

# Supported Uvicorn settings; explicit CLI arguments below also enforce these.
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8002
UVICORN_WORKERS=1

# Visible JD workspace synchronization interval (5–120 seconds).
JOBMITRA_JD_POLL_SECONDS=15
