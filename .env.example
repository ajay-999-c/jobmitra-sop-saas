# Copy to .env and fill the password locally. Never commit .env.
# Windows PostgreSQL server; the backend continues to run on macOS.
JOBMITRA_DB_HOST=192.168.1.51
JOBMITRA_DB_PORT=5432
JOBMITRA_DB_NAME=jobmitra_dev
JOBMITRA_DB_USER=jobmitra_app
JOBMITRA_DB_PASSWORD=replace-with-your-password
JOBMITRA_DB_SSLMODE=prefer
JOBMITRA_DB_CONNECT_TIMEOUT=5
JOBMITRA_DB_POOL_SIZE=3
JOBMITRA_DB_MAX_OVERFLOW=0
JOBMITRA_DB_POOL_TIMEOUT=5
JOBMITRA_DB_STATEMENT_TIMEOUT_MS=5000
JOBMITRA_AI_ENABLED=false
JOBMITRA_OFFICE_TIMEZONE=Asia/Kolkata

# Explicit absolute PRIVATE directory. Leave unset to disable file upload/download.
# Mac example only; configure a secured mount separately for Windows storage.
# JOBMITRA_DOCUMENT_STORAGE_ROOT=/Users/mac/Documents/jobmitra/sop-pipeline/private-data/documents
JOBMITRA_DOCUMENT_MAX_BYTES=12582912
