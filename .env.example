# Copy to the project-root .env and fill the password locally. Never commit .env.
# Loaded relative to the installed editable checkout, independent of NSSM working directory.
# Process environment overrides .env. Private storage paths must be absolute.
# Windows PostgreSQL server; the backend continues to run on macOS.
JOBMITRA_DB_HOST=192.168.1.51
JOBMITRA_DB_PORT=5432
JOBMITRA_DB_NAME=jobmitra_dev
JOBMITRA_DB_USER=jobmitra_app
JOBMITRA_DB_PASSWORD=replace-with-your-password
JOBMITRA_DB_SSLMODE=prefer
JOBMITRA_DB_CONNECT_TIMEOUT=5
JOBMITRA_DB_POOL_SIZE=3
JOBMITRA_DB_MAX_OVERFLOW=0
JOBMITRA_DB_POOL_TIMEOUT=5
JOBMITRA_DB_STATEMENT_TIMEOUT_MS=5000
JOBMITRA_AI_ENABLED=false
JOBMITRA_OFFICE_TIMEZONE=Asia/Kolkata

# Explicit absolute PRIVATE directory. Leave unset to disable file upload/download.
# Mac example only; configure a secured mount separately for Windows storage.
# JOBMITRA_DOCUMENT_STORAGE_ROOT=/Users/mac/Documents/jobmitra/sop-pipeline/private-data/documents
JOBMITRA_DOCUMENT_MAX_BYTES=12582912

# Optional resume uploads reuse DOCUMENT_STORAGE_ROOT (outside public/static folders).
# Windows example: D:/JobmitraData/private-documents
JOBMITRA_RESUME_MAX_BYTES=10485760

# Independent SQLite Resume Processing demo (disabled until explicitly configured).
# Use the EXISTING processor database. Do not create/copy a second candidate database.
JOBMITRA_RESUME_PROCESSING_ENABLED=false
# JOBMITRA_RESUME_PROCESSING_REPO=D:/Jobmitra/jobmitra-resume-processing
# JOBMITRA_RESUME_PROCESSING_PYTHON=C:/Users/EMPLOYEE/miniconda3/envs/gen_ai/python.exe
# JOBMITRA_RESUME_PROCESSING_DATABASE=D:/Jobmitra/jobmitra-resume-processing/private/jobmitra_candidates.sqlite3
# GROQ_API_KEY belongs in the processor environment/.env, never in source code.

# Independent ATS JD Workspace. Initialize a NEW database explicitly before enabling.
JOBMITRA_ATS_V2_ENABLED=false
# JOBMITRA_ATS_V2_DATABASE=D:/JobmitraData/private/ats-v2.sqlite3
# JOBMITRA_ATS_V2_RESUME_STORAGE_ROOT=D:/JobmitraData/private/ats-v2-resumes

# Normal service/LAN configuration stays disabled until an approved V3 cutover.
# Enabling this flag never migrates a database. See docs/unified-v12.md.
JOBMITRA_UNIFIED_V12_ENABLED=false
# Set independent random operator/supervisor secrets privately; no built-in credentials.
# JOBMITRA_UNIFIED_V12_OPERATOR_TOKEN=
# JOBMITRA_UNIFIED_V12_SUPERVISOR_TOKEN=

# Explicit office-network access without individual login/capability prompts.
# Disabled by default. Before enabling, verify the office interface subnet/mask.
# 192.168.1.0/24 was verified on the Mac office interface; confirm Windows matches.
# Also set ATS_V2_ENABLED=true, UNIFIED_V12_ENABLED=true, LOCAL_V12=0,
# and UNIFIED_V12_LOCAL_DIRECT_EDITING=false (all names use JOBMITRA_ prefix).
JOBMITRA_OFFICE_LAN_ENABLED=false
JOBMITRA_OFFICE_LAN_CIDRS=192.168.1.0/24,127.0.0.1/32,::1/128
# Optional exact internal DNS hostnames; IP Hosts are checked against the CIDRs.
JOBMITRA_OFFICE_LAN_HOSTS=
# Direct connections only; forwarded headers are rejected. See docs/v12-office-lan.md.

# Local development: Uvicorn with --app-dir src and an explicit loopback --host selects V12.
# JOBMITRA_LOCAL_V12=1 explicitly selects the same isolated profile; =0 retains normal settings.
# Uses the existing isolated runtime/v12-local/ats-v3.sqlite3; never migrates or reads .env.
# A Git pull excludes private databases. Prepare a NEW local copy once from Windows .env paths:
# uv run --no-sync python scripts/prepare_local_v12.py --from-config
# This explicit setup copies existing populated data; it never writes to the source database.
# See README.md. Leave normal production configuration unchanged.
